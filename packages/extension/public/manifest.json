{
  "manifest_version": 3,
  "name": "Elur DevTools",
  "version": "0.1.0",
  "description": "Official DevTools for the elur ecosystem: inspect components, signals, router state and query caches.",
  "homepage_url": "https://elur.dev/",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}