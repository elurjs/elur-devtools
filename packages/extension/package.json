{
  "name": "@elurjs/devtools-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension (MV3) for the elur DevTools. Build with `npm run build`, then load `dist/` as an unpacked extension.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --environment happy-dom"
  },
  "dependencies": {
    "@elurjs/core": "^3.6.2",
    "@elurjs/devtools-protocol": "0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "happy-dom": "^20.12.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}