{
  "name": "@elurjs/devtools-protocol",
  "version": "0.1.0",
  "description": "Message protocol shared between the elur devtools backend (in-page) and the browser extension.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}